# ─────────────────────────────────────────────────────────────────────────────
# JOEX Teacher Website — environment variables
# Copy this file to `.env.local` and fill in your values.
# Full instructions: see SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL — e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER-ONLY. Never expose to the browser.
# Used for admin operations (schema seeding, privileged reads).
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for canonical URLs, sitemap, OG tags)
# Must match the deployed domain, e.g. https://teacher.example.com
NEXT_PUBLIC_SITE_URL=https://joex-teacher.example

# ─────────────────────────────────────────────────────────────────────────────
# When NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY are empty,
# the site runs in PREVIEW MODE: all content is served from bundled seed data
# and a dismissible banner is shown. Add the keys above to switch to the
# persistent Supabase database — no code changes required.
# ─────────────────────────────────────────────────────────────────────────────
